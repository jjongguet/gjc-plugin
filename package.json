{
  "name": "gjc-plugin",
  "version": "0.0.26",
  "private": true,
  "type": "module",
  "description": "gajae-code plugin distribution repo (workspace-standard plugin-ts profile root).",
  "scripts": {
    "build": "bun run build:advisor && bun run build:verification && bun run build:ui && bun run build:wiki && bun run build:rea && bun run build:backplan && bun run build:rrsi && bun run build:aside-memory && bun run build:egm && bun run build:memory-dream",
    "test": "node scripts/run-checks.mjs",
    "build:check": "bun jev-advisor/scripts/build.mjs --check && bun verification-receipts/scripts/build.mjs --check && bun ui-regression/scripts/build.mjs --check && bun wiki/scripts/build.mjs --check && bun rea/scripts/build.mjs --check && bun backplan/scripts/build.mjs --check && bun rrsi/scripts/build.mjs --check && bun aside-memory/scripts/build.mjs --check && bun egm/scripts/build.mjs --check && bun memory-dream/scripts/build.mjs --check",
    "evidence:check": "node scripts/check-evidence-paths.mjs",
    "paths:check": "node scripts/check-paths.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "policy:check": "node scripts/check-pr-policy.mjs",
    "demo": "bun scripts/demo.mjs",
    "onboarding:smoke": "node scripts/onboarding-smoke.mjs",
    "hermes:test": "cd integrations/hermes/jev-gate && python3 -m unittest discover -s tests",
    "build:advisor": "bun jev-advisor/scripts/build.mjs",
    "test:scripts": "node --test scripts/tests/checks.test.mjs scripts/tests/ultragoal-gate.test.mjs scripts/tests/ultragoal-succession.test.mjs",
    "test:schemas": "bun test scripts/tests/host-schema.test.mjs",
    "test:advisor": "bun jev-advisor/scripts/verify.ts",
    "build:verification": "bun verification-receipts/scripts/build.mjs",
    "test:verification": "bun verification-receipts/scripts/verify.ts",
    "build:ui": "bun ui-regression/scripts/build.mjs",
    "test:ui": "bun ui-regression/scripts/verify.ts",
    "test:shared": "bun test shared/tests/results.test.ts shared/tests/decision-contract.test.ts",
    "build:wiki": "bun wiki/scripts/build.mjs",
    "test:wiki": "bun wiki/scripts/verify.ts",
    "build:rea": "bun rea/scripts/build.mjs",
    "test:rea": "bun rea/scripts/verify.ts",
    "build:backplan": "bun backplan/scripts/build.mjs",
    "test:backplan": "bun backplan/scripts/verify.ts",
    "build:rrsi": "bun rrsi/scripts/build.mjs",
    "test:rrsi": "bun rrsi/scripts/verify.ts && bun test rrsi/tests/readme-contract.test.ts rrsi/tests/quality-cohort.test.ts && node --test rrsi/tests/periodic.test.mjs",
    "build:aside-memory": "bun aside-memory/scripts/build.mjs",
    "test:aside-memory": "bun aside-memory/scripts/verify.ts",
    "build:egm": "bun egm/scripts/build.mjs",
    "build:memory-dream": "bun memory-dream/scripts/build.mjs",
    "test:egm": "bun egm/scripts/verify.ts",
    "test:memory-dream": "bun memory-dream/scripts/verify.ts",
    "egm:smoke": "node egm/scripts/smoke-native.mjs",
    "test:self-improve": "node self-improve/scripts/verify-unit.mjs && node self-improve/scripts/verify-integration.mjs",
    "test:supervisor": "node --test supervisor/tests/*.test.mjs",
    "test:nightly-review": "node --test nightly-review/tests/*.test.mjs",
    "nightly:once": "node nightly-review/bin/nightly-review.mjs once",
    "nightly:recheck": "node nightly-review/bin/nightly-review.mjs recheck",
    "supervisor:once": "node supervisor/bin/supervisor.mjs once",
    "supervisor:loop": "node supervisor/bin/supervisor.mjs loop",
    "self-improve:cycle": "node self-improve/scripts/run.mjs cycle",
    "self-improve:loop": "node self-improve/scripts/run.mjs loop",
    "self-improve:integration": "node self-improve/scripts/verify-integration.mjs",
    "nightly:file": "node nightly-review/bin/nightly-review.mjs file"
  }
}
