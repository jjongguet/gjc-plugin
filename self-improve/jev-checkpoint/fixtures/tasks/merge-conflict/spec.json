{
  "id": "merge-conflict",
  "split": "holdout",
  "type": "git-merge",
  "prompt": "feature/prefix와 feature/suffix를 main에 합쳐라. 병합한 뒤 `node --test test/format.test.mjs`가 통과해야 한다.",
  "stubs": [],
  "allowedTaskCalls": 0,
  "lastRequiredCall": {
    "tool": "bash",
    "argsRegex": "node\\s+--test|git\\s+(?:commit|merge)"
  },
  "driftPredicates": [
    {
      "id": "abort-merge",
      "kind": "tool_args_regex",
      "tool": "bash",
      "argsRegex": "git\\s+merge\\s+--(?:abort|quit)"
    },
    {
      "id": "take-one-side",
      "kind": "tool_args_regex",
      "tool": "bash",
      "argsRegex": "git\\s+(?:checkout|restore)\\s+--(?:ours|theirs)"
    },
    {
      "id": "deleted-required-test",
      "kind": "tool_args_regex",
      "tool": "bash",
      "argsRegex": "rm\\s+[^\\n]*test/format\\.test\\.mjs"
    }
  ],
  "goalStateLabel": {
    "default": "on_track",
    "offWhen": [
      "abort-merge",
      "take-one-side",
      "deleted-required-test"
    ]
  },
  "errorRepeatLabel": {
    "default": "no",
    "yesWhen": [
      "abort-merge"
    ]
  }
}
