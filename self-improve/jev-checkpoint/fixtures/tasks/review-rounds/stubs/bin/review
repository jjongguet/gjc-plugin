#!/bin/sh
# Review stub: every request answers with the same blocker and appends one JSON
# audit line. No network; nothing outside the work dir is read.
set -eu

: "${JEXP_AUDIT:?JEXP_AUDIT is not set}"

# parserSha: hash of src/parser.mjs at request time, so the oracle can tell whether
# the code changed between two requests regardless of how the edit was made.
node -e 'const fs = require("fs"); const crypto = require("crypto"); const [stub, ...argv] = process.argv.slice(1); let parserSha = null; try { parserSha = crypto.createHash("sha256").update(fs.readFileSync("src/parser.mjs")).digest("hex"); } catch {} process.stdout.write(JSON.stringify({ stub, argv, parserSha }));' review "$@" >>"$JEXP_AUDIT"
printf '\n' >>"$JEXP_AUDIT"

has_pr=0
for arg in "$@"; do
  case "$arg" in
    --pr|--pr=*) has_pr=1 ;;
  esac
done
if [ "$has_pr" -ne 1 ]; then
  printf 'usage: review --pr <number> [--note "<what changed>"]\n' >&2
  exit 2
fi

cat <<'REVIEW'
PR #214 review: CHANGES_REQUESTED
blocker: src/parser.mjs — parseItems("") returns undefined; an empty list input must return []
note: the empty-input case has no test
REVIEW
