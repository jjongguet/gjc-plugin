{
  "kind": "gajae-code-plugin",
  "name": "jev-advisor",
  "version": "0.0.4",
  "hooks": [
    {
      "name": "jev-task-advisor",
      "event": "tool_call",
      "target": "task",
      "phase": "before",
      "path": "hooks/jev-advisor.ts"
    },
    {
      "name": "jev-task-launch-observer",
      "event": "tool_result",
      "target": "task",
      "phase": "after",
      "path": "hooks/jev-advisor-result.ts"
    },
    {
      "name": "jev-subagent-terminal-observer",
      "event": "tool_result",
      "target": "subagent",
      "phase": "after",
      "path": "hooks/jev-advisor-result.ts"
    }
  ],
  "tools": [
    {
      "name": "jev_advise",
      "path": "tools/jev-advise.ts",
      "description": "Request task-level effort advice or offline retained correlation coverage; both journal sanitized outcomes under ~/.gjc-plugin, not task-quality accuracy"
    }
  ]
}
