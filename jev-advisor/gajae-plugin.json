{
  "kind": "gajae-code-plugin",
  "name": "jev-advisor",
  "version": "0.0.2",
  "hooks": [
    {
      "name": "jev-task-advisor",
      "event": "tool_call",
      "target": "task",
      "phase": "before",
      "path": "hooks/jev-advisor.ts"
    },
    {
      "name": "jev-task-outcome-advisor",
      "event": "tool_result",
      "target": "task",
      "phase": "after",
      "path": "hooks/jev-advisor-result.ts"
    }
  ],
  "tools": [
    {
      "name": "jev_advise",
      "path": "tools/jev-advise.ts",
      "description": "Ask the configured decision model for a subagent delegation tier recommendation, or pass report=\"calibration\" for local evidence-memory statistics (offline, no key)"
    }
  ]
}
